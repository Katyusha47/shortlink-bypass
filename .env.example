# ==========================================
# Universal Shortlink Bypasser Configuration
# ==========================================

# Application Metadata
APP_NAME="Universal Shortlink Bypasser"
SITE_URL="http://localhost:8000"
ENVIRONMENT="production"
DEBUG=false

# Resolution Network Limits
DEFAULT_TIMEOUT_SECONDS=8.0
MAX_REDIRECT_HOPS=10
MAX_RESPONSE_BODY_BYTES=2097152

# Security & SSRF Protection
# Set to true ONLY in local dev if resolving local test mock servers
ALLOW_PRIVATE_IPS=false

# Rate Limiting (In-memory sliding window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_BURST=10

# Caching (In-memory LRU)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=1000

